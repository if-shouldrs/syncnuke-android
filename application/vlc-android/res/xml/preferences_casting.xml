<?xml version="1.0" encoding="utf-8"?>

<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                                      xmlns:app="http://schemas.android.com/apk/res-auto"
                                      android:key="audio_category"
                                      android:title="@string/casting_category">
    <PreferenceCategory android:title="@string/casting_category">
        <CheckBoxPreference
                app:singleLineTitle="false"
                android:key="enable_casting"
                android:defaultValue="true"
                android:switchTextOff="Disabled"
                android:switchTextOn="Enabled"
                android:title="@string/casting_switch_title"/>
        <CheckBoxPreference
                android:key="casting_audio_only"
                android:defaultValue="false"
                android:summary="@string/casting_audio_only_summary"
                android:title="@string/casting_audio_only"
                android:dependency="enable_casting"/>
        <CheckBoxPreference
                android:key="casting_passthrough"
                android:defaultValue="false"
                android:summary="@string/casting_passthrough_summary"
                android:title="@string/casting_passthrough_title"
                android:dependency="enable_casting"/>
        <ListPreference
                android:defaultValue="2"
                android:entries="@array/casting_quality"
                android:entryValues="@array/casting_quality_values"
                android:key="casting_quality"
                android:summary="@string/casting_conversion_quality_summary"
                android:title="@string/casting_conversion_quality_title"
                android:dependency="enable_casting"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_sync_header">

        <SwitchPreferenceCompat app:iconSpaceReserved="false"
            app:key="syncEnabled"
            app:defaultValue="false"
            app:summaryOn="@string/pref_sync_enabled_on"
            app:summaryOff="@string/pref_sync_enabled_off"
            app:title="@string/pref_sync_enabled" />

        <EditTextPreference app:iconSpaceReserved="false"
            app:key="syncUsername"
            app:title="@string/pref_sync_username"
            app:dependency="syncEnabled"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference app:iconSpaceReserved="false"
            app:key="syncPassword"
            app:defaultValue=""
            app:title="@string/pref_sync_password"
            app:dependency="syncEnabled" />

        <EditTextPreference app:iconSpaceReserved="false"
            app:key="syncRoom"
            app:defaultValue="Default"
            app:title="@string/pref_sync_room"
            app:dependency="syncEnabled"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference app:iconSpaceReserved="false"
            app:key="syncProtocol"
            app:defaultValue="datasaver"
            app:title="@string/pref_sync_protocol"
            app:dependency="syncEnabled"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference app:iconSpaceReserved="false"
            app:key="syncServer"
            app:defaultValue="master.syncnuke.com"
            app:title="@string/pref_sync_server"
            app:dependency="syncEnabled"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference app:iconSpaceReserved="false"
            app:key="syncPort"
            app:defaultValue="65344"
            android:inputType="number"
            app:title="@string/pref_sync_port"
            app:dependency="syncEnabled"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
